# Database (Supabase PostgreSQL)
# Lấy từ Supabase Dashboard -> Project Settings -> Database -> Connection string
DATABASE_URL="postgresql://postgres.project-ref:password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.project-ref:password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require"

# NextAuth (tạo bằng: npx auth secret)
AUTH_SECRET="your-auth-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# App URL (dùng trong email templates)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================================
# Email (SMTP) - Dùng Gmail App Password hoặc Resend/SendGrid
# ============================================================
MAIL_HOST="smtp.gmail.com"
MAIL_PORT="587"
MAIL_USERNAME="your-email@gmail.com"
MAIL_PASSWORD="your-app-password"
MAIL_ENCRYPTION="tls"
MAIL_FROM_ADDRESS="your-email@gmail.com"
MAIL_FROM_NAME="Thiệp Cưới"
MAIL_TIMEOUT="20"

# ============================================================
# Google Drive (Upload ảnh lên Drive thay vì local)
# ============================================================
# Tạo Service Account tại: Google Cloud Console -> IAM -> Service Accounts
# Tạo key JSON rồi paste nội dung vào đây (1 dòng, không xuống hàng)
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"..."}'
# Tạo folder trên Google Drive, chia sẻ cho Service Account email, lấy ID từ URL
GOOGLE_DRIVE_FOLDER_ID="your-folder-id"

# ============================================================
# Payment Gateways (tùy chọn)
# ============================================================
# PayPal - https://developer.paypal.com
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="sandbox"

# MoMo - https://developers.momo.vn
MOMO_PARTNER_CODE=""
MOMO_ACCESS_KEY=""
MOMO_SECRET_KEY=""
MOMO_ENDPOINT="https://test-payment.momo.vn/v2/gateway/api/create"

# ============================================================
# Tùy chọn khác
# ============================================================
# Google Maps (hiển thị bản đồ trên thiệp)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""
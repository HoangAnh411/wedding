# Database (Supabase PostgreSQL)
# Lấy từ Supabase Dashboard -> Project Settings -> Database -> Connection string
# Nếu dùng pooler, thêm ?pgbouncer=true&sslmode=require
DATABASE_URL="postgresql://postgres.project-ref:password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Supabase (Project URL & Anon Key - từ Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# NextAuth (tạo bằng: npx auth secret)
AUTH_SECRET="your-auth-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Resend (Email) - https://resend.com/api-keys
RESEND_API_KEY="re_placeholder"

# Zalo OA (tùy chọn)
ZALO_OA_ACCESS_TOKEN=""
ZALO_OA_ID=""

# Google Maps (tùy chọn)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

# Cloudinary (tùy chọn)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
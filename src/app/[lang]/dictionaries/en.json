  "guide": {
    "metadata": {
      "title": "User Guide & Feedback | WeddingApp",
      "description": "Learn how to use the wedding invitation platform and send feedback to the development team."
    },
    "header": {
      "title": "WeddingApp User Guide",
      "subtitle": "Discover how to create and manage your online wedding invitation with ease."
    },
    "sections": {
      "account": {
        "title": "1. Create an Account & Login",
        "content": "You can easily log in via Google or Zalo. After logging in, the system will automatically create an account for you and redirect you to the Dashboard."
      },
      "createWedding": {
        "title": "2. Create a New Wedding",
        "intro": "On the Dashboard, click the \"Create New Invitation\" button. You need to fill in the basic information:",
        "items": [
          "Bride & Groom names",
          "Date & time (Ceremony, Reception)",
          "Venue location",
          "Custom URL for your invitation"
        ]
      },
      "guests": {
        "title": "3. Guest Management & RSVP",
        "content": "You can import your guest list from an Excel file or add guests manually. The system provides unique QR codes and links for each guest so they can confirm their attendance (RSVP). You can track confirmed guests directly on the Dashboard."
      },
      "design": {
        "title": "4. Design & Customize Your Invitation",
        "content": "Use the Invitation Designer tool to change colors, fonts (currently supporting Modern, Classic, and Floral styles), and arrange content blocks like Introduction, Events, Gallery, and Wishes."
      },
      "moneyGift": {
        "title": "5. Receive Wedding Gifts Online",
        "content": "Add your bank account (or MoMo/PayPal) information in the Payment Settings. The system will automatically generate VietQR codes on your invitation so guests can easily transfer wedding gifts."
      }
    }
  },
